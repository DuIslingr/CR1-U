msgid ""
"waifu2x / Real-ESRGAN upscales from textures/hd (tools/hd_textures.py); from the next room on"
msgstr ""
"textures/hd의 waifu2x / Real-ESRGAN 업스케일(tools/hd_textures.py). 다음 방부터 적용"

#: src/app/scene_fx.cpp
msgid "None in textures/hd yet: --export-textures, then tools/hd_textures.py"
msgstr "textures/hd에 아직 없음: --export-textures 후 tools/hd_textures.py"

#: src/app/scene_fx.cpp
msgid "HD Models"
msgstr "HD 모델"

#: src/app/scene_fx.cpp
msgid ""
"Replacement models (glTF) from models/hd, in place of the game's; from the next room on"
msgstr "models/hd의 교체 모델(glTF)을 게임 모델 대신 사용. 다음 방부터 적용"

#: src/app/scene_fx.cpp
msgid ""
"None in models/hd yet: --export-models, edit in Blender, save as models/hd/<name>.glb"
msgstr ""
"models/hd에 아직 없음: --export-models 후 Blender에서 편집해 models/hd/<name>.glb로 저장"

#: src/app/scene_fx.cpp
msgid "Smooth"
msgstr "부드럽게"

#: src/app/scene_fx.cpp
msgid "Smoother"
