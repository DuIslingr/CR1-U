#: src/app/scene_fx.cpp
msgid "Upscaler"
msgstr "Масштабирование"

#: src/app/scene_fx.cpp
msgid "The scene renders smaller and is reconstructed; the menus stay sharp"
msgstr ""
"Сцена рендерится в меньшем разрешении и восстанавливается; меню остаются чёткими"

#: src/app/scene_fx.cpp
msgid "Upscale Mode"
msgstr "Режим масштабирования"

#: src/app/scene_fx.cpp
msgid "The scene at {0}% of the frame per side"
msgstr "Сцена — {0}% кадра по каждой стороне"

#: src/app/scene_fx.cpp
msgid "Sharpness"
msgstr "Резкость"

#: src/app/scene_fx.cpp
msgid "FSR's sharpening pass (RCAS); DLSS has none"
msgstr "Этап повышения резкости FSR (RCAS); в DLSS его нет"

#: src/gfx/render_device.hpp
msgid "needs the Vulkan renderer"
msgstr "требуется рендерер Vulkan"

#: src/gfx/vk_device.cpp
msgid "this GPU lacks what temporal upscaling needs"
msgstr ""
"видеокарта не поддерживает функции, нужные для временного масштабирования"

#: src/gfx/vk_device.cpp
msgid "this GPU can't run FSR 3.1"
msgstr "эта видеокарта не поддерживает FSR 3.1"

#: src/gfx/vk_device.cpp
msgid "MetalFX is Apple's: macOS only"
msgstr "MetalFX — технология Apple, только для macOS"

