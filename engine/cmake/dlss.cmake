# NVIDIA DLSS: the NGX headers and library from CR_DLSS_SDK - third_party/dlss (include/, lib/: the
# Linux library as vendored there, not in the repository) or a checkout of the SDK itself
# (github.com/NVIDIA/DLSS: lib/Linux_x86_64/, lib/Windows_x86_64/x64/). Linux x86-64 and Windows
# x64 with MSVC (NGX's libraries are MSVC's: not MinGW). The DLSS runtime - libnvidia-ngx-dlss.so.*
# or nvngx_dlss.dll - is copied next to the game: CR_DLSS_RUNTIME, else the SDK's lib/<platform>/rel/.
#   CR_DLSS: found; cr_link_dlss(target): its headers, library, CR_HAVE_DLSS and the runtime copy
set(CR_DLSS_SDK "${THIRD_PARTY_DIR}/dlss" CACHE PATH "The DLSS SDK (include/, lib/)")
set(CR_DLSS_RUNTIME "" CACHE FILEPATH "The DLSS runtime to copy next to the game (default: the SDK's)")
set(CR_DLSS OFF)
set(CR_DLSS_LIB "")
set(cr_dlss_runtime "${CR_DLSS_RUNTIME}")
if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64" AND EXISTS ${CR_DLSS_SDK}/include/nvsdk_ngx_vk.h)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        foreach(l ${CR_DLSS_SDK}/lib/libnvsdk_ngx.a ${CR_DLSS_SDK}/lib/Linux_x86_64/libnvsdk_ngx.a)
            if(EXISTS ${l} AND NOT CR_DLSS_LIB)
                set(CR_DLSS_LIB ${l})
            endif()
        endforeach()
        if(NOT cr_dlss_runtime)
            file(GLOB cr_dlss_runtime ${CR_DLSS_SDK}/lib/Linux_x86_64/rel/libnvidia-ngx-dlss.so.*)
        endif()
    elseif(WIN32 AND MSVC)
        # (_d: the DLL C runtime, /MD - CMake's default)
        foreach(l ${CR_DLSS_SDK}/lib/nvsdk_ngx_d.lib ${CR_DLSS_SDK}/lib/Windows_x86_64/x64/nvsdk_ngx_d.lib)
            if(EXISTS ${l} AND NOT CR_DLSS_LIB)
                set(CR_DLSS_LIB ${l})
            endif()
        endforeach()
        if(NOT cr_dlss_runtime AND EXISTS ${CR_DLSS_SDK}/lib/Windows_x86_64/rel/nvngx_dlss.dll)
            set(cr_dlss_runtime ${CR_DLSS_SDK}/lib/Windows_x86_64/rel/nvngx_dlss.dll)
        endif()
    endif()
    if(CR_DLSS_LIB)
        set(CR_DLSS ON)
    endif()
endif()
option(CR_DLSS_REQUIRED "Fail if the DLSS SDK is not found (CI's DLSS check)" OFF)
if(CR_DLSS_REQUIRED AND NOT CR_DLSS)
    message(FATAL_ERROR "DLSS: no NGX library for this platform in CR_DLSS_SDK (${CR_DLSS_SDK})")
endif()

function(cr_link_dlss target)
    target_include_directories(${target} SYSTEM PRIVATE ${CR_DLSS_SDK}/include)
    target_link_libraries(${target} PRIVATE ${CR_DLSS_LIB} ${CMAKE_DL_LIBS})
    target_compile_definitions(${target} PRIVATE CR_HAVE_DLSS=1)
    if(cr_dlss_runtime)
        list(GET cr_dlss_runtime 0 runtime)
        get_filename_component(name ${runtime} NAME)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different ${runtime} $<TARGET_FILE_DIR:${target}>/${name})
        if(WIN32)
            set(where "next to the .exe")
        else()
            set(where "next to the game")
        endif()
        message(STATUS "Upscalers: FSR 3.1, DLSS (runtime ${name}, copied ${where})")
    else()
        message(STATUS "Upscalers: FSR 3.1, DLSS (no runtime found: CR_DLSS_RUNTIME)")
    endif()
endfunction()
