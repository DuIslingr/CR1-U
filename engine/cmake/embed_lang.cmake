# Writes OUT, a C++ file holding every lang/<code>.po as bytes (platform/ui_text.cpp's kBuiltIn) -
# run at build time (cmake -DLANG_DIR=... -DOUT=... -P embed_lang.cmake), again when a catalog changes
file(GLOB catalogs "${LANG_DIR}/*.po")
list(SORT catalogs)
set(body "// Generated by cmake/embed_lang.cmake from lang/*.po - edit those, not this\n#include <cstddef>\n\nnamespace uitext {\n\nstruct BuiltIn {\n    const char* code;\n    const unsigned char* data;\n    size_t size;\n};\n\n")
set(entries "")
set(n 0)
foreach(po ${catalogs})
    get_filename_component(code "${po}" NAME_WE)
    file(READ "${po}" hex HEX)
    string(LENGTH "${hex}" len)
    math(EXPR bytes "${len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" hex "${hex}")
    string(APPEND body "static const unsigned char kCatalog${n}[] = {\n${hex}0};\n\n")
    string(APPEND entries "    {\"${code}\", kCatalog${n}, ${bytes}},\n")
    math(EXPR n "${n} + 1")
endforeach()
if(n EQUAL 0)
    string(APPEND body "extern const BuiltIn kBuiltIn[] = {{nullptr, nullptr, 0}};\nextern const size_t kBuiltInCount = 0;\n")
else()
    string(APPEND body "extern const BuiltIn kBuiltIn[] = {\n${entries}};\nextern const size_t kBuiltInCount = ${n};\n")
endif()
string(APPEND body "\n} // namespace uitext\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL body)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${body}")
